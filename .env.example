# ============================================================
# CAFÉ ARTISANAL — CONFIGURAÇÃO DE AMBIENTE (.env)
# Disciplina: Segurança em Sistemas da Informação (FICR)
# ============================================================

# Porta do servidor web
PORT=3000

# Chave secreta para assinatura dos tokens JWT (mínimo 32 caracteres)
JWT_SECRET=cafe_artisanal_super_secret_jwt_key_2025_ficr_seguranca

# ============================================================
# CREDENCIAIS DO SUPABASE (Obtidas em Project Settings > API)
# URL: Project URL (ex: https://abcdefghijklm.supabase.co)
# KEY: anon public key ou service_role secret key
# ============================================================
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-ou-service-role-aqui
